{
  "name": "claude-session-namer",
  "version": "1.3.1",
  "description": "Project-first \"project - topic\" titles for AI coding sessions: a Claude Code plugin plus adapters and a one-command installer for 13 other agents.",
  "private": true,
  "license": "MIT",
  "author": "BolaLabs (https://github.com/brunobola-portfolio)",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunobola-portfolio/claude-session-namer.git"
  },
  "bin": {
    "session-namer": "bin/session-namer.js"
  },
  "files": [
    "bin/",
    "lib/",
    "hooks/",
    "adapters/",
    "commands/",
    ".claude-plugin/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "doctor": "node hooks/session-name-cli.js --doctor",
    "release:check": "node scripts/release.js --check",
    "release": "node scripts/release.js",
    "assets": "node scripts/build-assets.js"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "codex",
    "opencode",
    "copilot-cli",
    "gemini-cli",
    "ai-agents",
    "coding-agents",
    "session-title",
    "hooks",
    "remote-control",
    "terminal-title"
  ],
  "pi": {
    "extensions": [
      "./adapters/pi/index.js"
    ]
  },
  "homepage": "https://github.com/brunobola-portfolio/claude-session-namer#readme",
  "bugs": {
    "url": "https://github.com/brunobola-portfolio/claude-session-namer/issues"
  }
}
